<script src="/js/site.js"></script>
<meta name="og:url" content="https://go.dev{{.URL}}">
<meta name="og:title" content="{{if strings.HasPrefix .URL "/wiki/"}}Go Wiki: {{end}}{{.title}}{{if ne .URL "/"}} - Go 编程语言{{end}}">
<title>{{if strings.HasPrefix .URL "/wiki/"}}Go Wiki: {{end}}{{.title}}{{if ne .URL "/"}} - Go 编程语言{{end}}</title>
{{if .summary}}
<meta name="og:description" content="{{.summary}}">
<meta name="description" content="{{.summary}}">
{{end}}
<meta name="og:image" content="https://go.dev/doc/gopher/gopher5logo.jpg">
<meta name="twitter:image" content="https://go.dev/doc/gopher/{{if strings.HasPrefix .URL "/blog/"}}runningsquare.jpg{{else}}gopherbelly300.jpg{{end}}">
